# PocketBase base URL (no trailing slash)
PB_URL=http://127.0.0.1:8090

# Admin or operator account the bridge authenticates as. It needs to read
# gate_triggers and call /api/gate-event (both require an authenticated user).
PB_IDENTITY=admin@example.com
PB_PASSWORD=change-me

# Auth collection for the account above ("users" for admin/operator accounts,
# or "_superusers" for a PocketBase superuser).
PB_AUTH_COLLECTION=users

# How often (seconds) to re-read trigger config and reconcile watchers/servers.
CONFIG_POLL_SECONDS=15
